<?xml version="1.0" encoding="utf-8"?>
<!-- Link — present / real-time ops: two interlocking chain links over a live pulse,
     the pulse peak crimson. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Right link first, then a charcoal cut where the left link crosses it, then the
         left link on top — so the two read as interlocking rather than as two overlapping
         pills at icon size. -->
    <path
        android:pathData="M30,12 H33 A8,8 0 0 1 33,28 H30 A8,8 0 0 1 30,12 Z"
        android:fillColor="#00000000"
        android:strokeColor="#C9CDD4"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M24,12 V28"
        android:fillColor="#00000000"
        android:strokeColor="#0E0E10"
        android:strokeWidth="5" />
    <path
        android:pathData="M15,12 H18 A8,8 0 0 1 18,28 H15 A8,8 0 0 1 15,12 Z"
        android:fillColor="#00000000"
        android:strokeColor="#C9CDD4"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M6,38 H16 L19,33 L24,43 L27,38 H42"
        android:fillColor="#00000000"
        android:strokeColor="#D42B2B"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
