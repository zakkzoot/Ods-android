<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher grid: four columns by three rows of home-screen cells. targetCell* asks
  the launcher for exactly that footprint on Android 12+; minWidth/minHeight cover older
  launchers (roughly 4 × 70dp and 3 × 70dp, less the standard 30dp margin).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/launcher_widget_description"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="140dp"
    android:maxResizeWidth="640dp"
    android:maxResizeHeight="480dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" />
